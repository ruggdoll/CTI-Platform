# Réglages MariaDB pour la pile MISP de CTI-Platform — monté dans le conteneur `db` par compose.tuning.yml.
# Cible : machine 4 vCPU / 31 Go RAM, charge = imports d'IOC en masse (INSERT +
# corrélation). Les valeurs pilotées par variables d'env (buffer pool, log file,
# io capacity, io threads) restent dans vendor/misp-docker/.env — ne pas les
# dupliquer ici pour éviter les conflits.
[mariadb]
# Durabilité relâchée : les données de feed sont re-récupérables, on privilégie
# le débit d'écriture. 2 = flush au commit mais fsync 1x/s (perte max ~1 s sur crash OS).
innodb_flush_log_at_trx_commit = 2

# Purge des lignes d'undo plus agressive pendant les gros imports.
innodb_purge_threads = 4

# Le buffer de tri / jointure par session (le matching warninglists en profite).
join_buffer_size = 8M
sort_buffer_size = 8M
read_rnd_buffer_size = 4M

# Plus de connexions simultanées (workers MISP + provisioning en parallèle).
max_connections = 300

# Cache de tables ouvert plus large (MISP a beaucoup de tables).
table_open_cache = 4000
table_definition_cache = 2000

# Laisser InnoDB adapter le nombre de threads au parallélisme réel.
innodb_thread_concurrency = 0
