# OpenCTI — config locale (gitignoré). Généré par `make init HOST=<fqdn|ip>`.
#
# Adressage de l'infra : CTI_HOSTNAME est le nom (FQDN) ou l'IP par lequel les
# CLIENTS joignent la plateforme — pas le nom interne des conteneurs. Les deux
# piles doivent porter le même : MISP répond sur https://<CTI_HOSTNAME> et
# OpenCTI sur <scheme>://<CTI_HOSTNAME>:<port>. Une valeur fausse casse les
# redirections, les liens des rapports et la vérification CSRF d'OpenCTI.
# BIND_ADDRESS=0.0.0.0 publie les ports sur toutes les interfaces (déploiement
# sur une machine distante) ; 127.0.0.1 les restreint au poste local.
BIND_ADDRESS=0.0.0.0

ELASTIC_MEMORY_SIZE=4G          # dimensionné par `make init` sur la RAM réelle (25 %, borné à 8 Go)

MINIO_ROOT_USER=opencti
MINIO_ROOT_PASSWORD=CHANGEME
RABBITMQ_DEFAULT_USER=opencti
RABBITMQ_DEFAULT_PASS=CHANGEME
SMTP_HOSTNAME=localhost

# nom public d'OpenCTI = CTI_HOSTNAME (renseigné par `make init HOST=…`)
OPENCTI_HOST=localhost
# Adresse visée par `extra_hosts` de connector-misp-intel pour joindre MISP par
# son nom public. `host-gateway` en rootful ; en ROOTLESS, l'adresse réelle de
# l'hôte — sinon le pont OpenCTI -> MISP ne publie rien. `make init` renseigne.
CTI_HOST_TARGET=host-gateway
# Sursis avant SIGKILL : généreux pour ce qui porte des données (Elasticsearch,
# MinIO, RabbitMQ, la plateforme), court pour les processus sans état, où
# attendre ne sert à rien. Défaut Docker sans ces valeurs : 10 s pour tous.
STOP_GRACE_DATA=120s
STOP_GRACE_APP=30s
OPENCTI_PORT=8080
OPENCTI_EXTERNAL_SCHEME=http
OPENCTI_ADMIN_EMAIL=admin@cti-lab.local
OPENCTI_ADMIN_PASSWORD=CHANGEME
OPENCTI_ADMIN_TOKEN=CHANGEME
OPENCTI_HEALTHCHECK_ACCESS_KEY=CHANGEME
OPENCTI_ENCRYPTION_KEY=CHANGEME

# --- connecteurs internes ---
CONNECTOR_IMPORT_FILE_STIX_ID=CHANGEME
CONNECTOR_IMPORT_DOCUMENT_ID=CHANGEME
CONNECTOR_ANALYSIS_ID=CHANGEME
CONNECTOR_MITRE_ID=CHANGEME

# --- connecteurs externes (cœur Phase 4) ---
CONNECTOR_CISA_KEV_ID=CHANGEME
CONNECTOR_MISP_ID=CHANGEME
# identité du connecteur du pont retour : sans elle, connector-misp-intel
# refuse de s'enregistrer (BAD_USER_INPUT sur $input.id) et boucle.
CONNECTOR_MISP_INTEL_ID=CHANGEME
# id du live stream OpenCTI consommé par le pont retour : renseigné par
# 'make bridge-setup', qui crée le stream s'il n'existe pas.
CONNECTOR_MISP_INTEL_STREAM_ID=CHANGEME

# --- pont MISP -> OpenCTI ---
# MISP_URL : nom INTERNE du conteneur MISP (les connecteurs parlent à MISP sur
# le réseau Docker) — ne pas y mettre CTI_HOSTNAME.
# Organisation MISP de la plateforme : celle qui porte les events créés par
# le pont OpenCTI -> MISP, et la seule dont connector-misp réimporte les
# events. Doit exister côté MISP (renommer l'org admin par défaut).
MISP_ORG=ruggdoll

MISP_URL=https://cti-platform-misp-misp-core-1
MISP_KEY=CHANGEME
# MISP_REFERENCE_URL : URL PUBLIQUE de MISP, affichée dans les références des
# rapports importés. Doit être joignable par un lecteur => https://<CTI_HOSTNAME>.
MISP_REFERENCE_URL=https://localhost
# forward-only : mettre la date du jour du 1er démarrage. Un backfill historique
# large fait s'effondrer l'ingestion sur 4 cœurs. Voir provisioning/opencti_bridge_skip.md
MISP_IMPORT_FROM_DATE=2026-09-01
