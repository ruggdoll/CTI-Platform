##
# Config de déploiement CTI-Platform — à copier vers vendor/misp-docker/.env
#
#   cp .env.example vendor/misp-docker/.env
#
# Les valeurs <CHANGE_ME...> DOIVENT être remplacées. `make init` génère
# automatiquement les secrets aléatoires si ce fichier n'existe pas encore.
##

# --- Versions des images (voir vendor/misp-docker/template.env pour les dernières) ---
CORE_TAG=v2.5.44
MODULES_TAG=v3.0.9
GUARD_TAG=v1.2
# Tags des images EXÉCUTÉES (CORE_TAG ne sert qu'au build). Sans eux, compose tire
# `latest`, qui depuis misp-docker PR #430 n'embarque plus nginx (service séparé
# misp-nginx) : misp-core n'écoute plus en 80/443 et l'API est injoignable.
# À faire évoluer ensemble avec le sous-module vendor/misp-docker.
CORE_RUNNING_TAG=v2.5.44
MODULES_RUNNING_TAG=v3.0.9
GUARD_RUNNING_TAG=v1.2

# --- Accès / URL ---
# BASE_URL = nom (FQDN) ou IP par lequel les CLIENTS joignent MISP, pas le nom
# du conteneur. `make init HOST=<fqdn|ip>` le renseigne à partir de CTI_HOSTNAME
# et aligne OpenCTI dessus. MISP construit toutes ses URL absolues à partir de
# cette valeur : si elle dit « localhost » alors qu'on accède par un FQDN, les
# redirections, les liens des events et l'API cassent depuis une autre machine.
# Inclure le port s'il n'est pas standard (ex: https://serveurCTI:8443).
BASE_URL=https://localhost
# Le même nom, seul : le healthcheck de misp-core appelle BASE_URL depuis
# l'intérieur du conteneur, où un nom du LAN (ou un .local mDNS) ne se résout
# pas. compose.tuning.yml le fait pointer sur l'hôte (CTI_HOST_TARGET).
CTI_HOSTNAME=localhost
# Adresse que le CONTENEUR doit viser pour joindre l'hôte. `host-gateway` en
# rootful ; en ROOTLESS il faut l'adresse réelle de l'hôte sur le réseau, car
# `host-gateway` y désigne le pont docker0 de l'espace de noms de RootlessKit,
# où aucun port publié n'est écouté. `make init` détecte et renseigne.
CTI_HOST_TARGET=host-gateway
CORE_HTTP_PORT=80
CORE_HTTPS_PORT=443
# Interface d'écoute des ports publiés : 0.0.0.0 pour une machine distante,
# 127.0.0.1 pour restreindre au poste local (appliqué par compose.tuning.yml).
BIND_ADDRESS=0.0.0.0
DISABLE_IPV6=true

# --- Compte admin (user #1) ---
ADMIN_EMAIL=admin@cti-lab.local
ADMIN_ORG=ruggdoll
ADMIN_PASSWORD=<CHANGE_ME_ADMIN_PASSWORD>
# Laisser vide => MISP génère la clé API au 1er démarrage (récupérable via `make admin-key`)
ADMIN_KEY=
GPG_PASSPHRASE=<CHANGE_ME_GPG_PASSPHRASE>

# --- Secrets applicatifs (32+ car. aléatoires) ---
ENCRYPTION_KEY=<CHANGE_ME_ENCRYPTION_KEY>
SALT=<CHANGE_ME_SALT>

# --- Base de données ---
MYSQL_PASSWORD=<CHANGE_ME_MYSQL_PASSWORD>
MYSQL_ROOT_PASSWORD=<CHANGE_ME_MYSQL_ROOT_PASSWORD>

# --- Redis / Valkey ---
REDIS_PASSWORD=<CHANGE_ME_REDIS_PASSWORD>

# --- Divers ---
TZ=Europe/Paris
ENABLE_DB_SETTINGS=true
# 0 en production, 1 pour debug
DEBUG=0

# --- Cadence des tâches planifiées (secondes) ---
CRON_USER_ID=1
FETCH_FEED_INTERVAL=86400
CACHE_FEED_INTERVAL=86400

# --- Tuning MariaDB (adapter à la RAM de la machine ; ici 4 vCPU / 31 Go) ---
# Le gros de la charge de la plateforme = INSERT + corrélation sur des millions d'attributs.
INNODB_BUFFER_POOL_SIZE=12288M   # dimensionné par `make init` sur la RAM réelle (20 %) ; doit contenir attributes+correlations+index
INNODB_IO_CAPACITY=2000
INNODB_IO_CAPACITY_MAX=4000
INNODB_LOG_FILE_SIZE=2G
INNODB_READ_IO_THREADS=8
INNODB_WRITE_IO_THREADS=8
INNODB_CHANGE_BUFFERING=all      # défaut misp-docker = none ; 'all' accélère les INSERT en masse
INNODB_STATS_PERSISTENT=ON
# innodb_flush_log_at_trx_commit=2 est posé par docker/mariadb-tuning.cnf (via compose.tuning.yml)

# --- Relais SMTP (optionnel — laisser vide pour désactiver l'envoi de mail) ---
SMARTHOST_ADDRESS=
SMARTHOST_PORT=
SMARTHOST_USER=
SMARTHOST_PASSWORD=
SMARTHOST_ALIASES=
SES_USER=
SES_PASSWORD=
SES_REGION=
SES_PORT=
