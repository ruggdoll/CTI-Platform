# Proxy inverse de la plateforme — deux identités, une seule façade.
#
# Il n'existe QUE pour l'extérieur : navigateurs, outils d'alimentation,
# abonnés TAXII. Les échanges internes de la plateforme (connecteurs vers
# OpenCTI, OpenCTI vers Elasticsearch, pont MISP) passent par les noms de
# conteneurs sur les réseaux Docker et ne le traversent jamais.
#
# `tls internal` : Caddy tient sa propre autorité de certification, émet les
# certificats des deux noms et les renouvelle seul. Aucune régénération
# périodique à prévoir. Le seul geste manuel est d'importer la racine dans le
# magasin de confiance des postes clients, une fois — « make proxy-ca ».
#
# Pour passer à un domaine public (Let's Encrypt), remplacer `tls internal` par
# `tls { dns <registrar> <jeton> }` : le challenge DNS-01 n'exige aucune
# exposition sur Internet, seulement un TXT dans la zone. Rien d'autre ne bouge.

{
	admin off
	# Pas de courriel ACME : l'autorité est locale.
}

{$MISP_HOSTNAME} {
	tls internal
	# misp-core sert du HTTP clair sur 80 (la redirection vers 443 est
	# commentée dans son nginx) : on termine le TLS ici, une seule fois,
	# plutôt que de rechiffrer vers son certificat auto-signé interne.
	reverse_proxy misp-core:80
}

{$OPENCTI_HOSTNAME} {
	tls internal
	# Le live stream d'OpenCTI est du SSE : Caddy ne tamponne pas les
	# réponses en flux, rien à régler. Un nginx demanderait proxy_buffering off.
	reverse_proxy opencti:8080
}
